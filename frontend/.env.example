# Public API URLs exposed to browser code.
# Using a relative URL `/api/v1` routes requests through the Next.js reverse-proxy rewrite
# (or APISIX gateway), preventing mixed-content, CORS, and PNA issues when accessed via ngrok or public domains.
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public OIDC client settings. Never add a client secret here: this is a
# Keycloak public client using Authorization Code + PKCE.
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:18080/realms/openvie
NEXT_PUBLIC_OIDC_CLIENT_ID=openvie-frontend
API_INTERNAL_URL=http://localhost:8080

# Next.js dev WebSocket origins (hostnames only, comma-separated); leave empty for localhost/127.0.0.1.
# Set to your tunnel hostname when accessing `next dev` through ngrok/APISIX, then restart Next.js.
NEXT_DEV_ALLOWED_ORIGINS=
