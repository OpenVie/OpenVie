# Public API URLs exposed to browser code.
# Using a relative URL `/api/v1` routes requests through the Next.js reverse-proxy rewrite
# (or APISIX gateway), preventing mixed-content, CORS, and PNA issues when accessed via ngrok or public domains.
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:8080

# Temporary compatibility alias. Remove after all clients use API_BASE_URL.
NEXT_PUBLIC_API_URL=http://localhost:8080
