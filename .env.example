# Repository-root Compose configuration (local development).
#
# `docker compose` reads this file (copied to `.env`) for variable
# interpolation in docker-compose.yml. Host-run processes do not depend on it:
# Spring loads api/.env, the Next.js client loads frontend/.env.local, and the
# Python app reads rag-chatbot-fastapi/.env *on top of* this file, so
# service-level values win for any key defined in both places. That is why
# container DNS names (ollama, qdrant, reranker-service, ...) are safe here:
# keep host-reachable URLs in the service-level files.
#
# Copy with: test -f .env || cp .env.example .env

APP_ENV=development
LOG_LEVEL=INFO

# ── Keycloak OIDC identity provider ──────────────────────────────────

KEYCLOAK_PORT=18080
KEYCLOAK_PUBLIC_URL=http://localhost:18080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# ── Interpolated into docker-compose.yml services ────────────────────────────
POSTGRES_DB=openvie
POSTGRES_USER=openvie
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=15432

REDIS_PORT=16379
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_OPERATION_TIMEOUT_SECONDS=1
RABBITMQ_DEFAULT_USER=rag_user
RABBITMQ_DEFAULT_PASS=rag_password
RABBITMQ_PORT=15673
RABBITMQ_MANAGEMENT_PORT=25672

QDRANT_HTTP_PORT=16333
QDRANT_GRPC_PORT=16334
QDRANT_COLLECTION=knowledge_units_v2
QDRANT_DENSE_VECTOR_NAME=text_bge_m3_v1
QDRANT_SPARSE_VECTOR_NAME=text_bm25_v1

GRAPH_SERVICE_PORT=8010
GRAPH_INTERNAL_TOKEN=development-graph-token
GRAPH_MAX_HOPS=3
# Optional LLM-based entity/relation extraction for Kuzu Graph. Set to true
# when GPU capacity is available; false skips LLM extraction during ingestion
# so documents index in 2-3 seconds using dense BGE-M3 + sparse FastEmbed.
GRAPH_EXTRACTION_ENABLED=true
GRAPH_EXTRACTION_BATCH_SIZE=4
GRAPH_EXTRACTION_MAX_OUTPUT_TOKENS=512
GRAPH_EXTRACTION_MAX_ENTITIES_PER_UNIT=2
GRAPH_EXTRACTION_MAX_RELATIONS_PER_UNIT=2

# Edge gateway (Apache APISIX). Single HTTP entry point for the web client and
# the business API; see docs/DEPLOYMENT.md#9-edge-gateway-apache-apisix.
# Port 8088 is the one Caddyfile.dev also uses: run one of them, not both.
APISIX_PORT=8088

# Concurrent in-flight documents per worker. Raises ingestion throughput but
# requires the model server to serve parallel requests.
INGESTION_WORKER_CONCURRENCY=4

# ── OCR (scanned PDFs + standalone images) ───────────────────────────────────
# Off by default: with every toggle commented, ingestion behaves byte-identical
# to the legacy pipeline and spends no OCR time. Turning it on lets the worker
# rasterize and recognize pages without a text layer (Tesseract, vie+eng) and
# accept image uploads on the API side. The Docker image ships tesseract-ocr
# with vie/eng packs; for host-run development install it instead:
#   macOS: brew install tesseract tesseract-lang   (tesseract-lang carries vie)
#   Debian/Ubuntu: apt install tesseract-ocr tesseract-ocr-vie tesseract-ocr-eng
# Host-run services read rag-chatbot-fastapi/.env and api/.env, which WIN over
# this file; the block below only feeds docker compose. Setting knobs for one
# strong dev machine: 300 DPI stays the sweet spot, raise
# INGESTION_OCR_PAGE_CONCURRENCY (1-16) before raising INGESTION_WORKER_CONCURRENCY.
# INGESTION_OCR_ENABLED=false
# INGESTION_OCR_PROVIDER=tesseract
# INGESTION_OCR_LANGUAGES=vie+eng
# INGESTION_OCR_DPI=300
# INGESTION_OCR_MIN_TEXT_CHARS_PER_PAGE=32
# INGESTION_OCR_MAX_PAGES=300
# INGESTION_OCR_MAX_MEGAPIXELS_PER_PAGE=25.0
# INGESTION_OCR_TIMEOUT_SECONDS_PER_PAGE=60.0
# INGESTION_OCR_PAGE_CONCURRENCY=2
# INGESTION_OCR_PSM=3
# Also OCR images embedded inside printable documents (PDF pages that still
# have a text layer, .docx, .xlsx); best-effort, capped at 64 images/doc.
# INGESTION_OCR_EMBEDDED_IMAGES=false
# Vision-language backend (INGESTION_OCR_PROVIDER=ollama-vlm; MODEL_ID required
# there). Ollama native port serves the vision chat endpoint.
# OCR_VLM_BASE_URL=http://localhost:11434
# OCR_VLM_MODEL_ID=
# OCR_VLM_TIMEOUT_SECONDS=180.0
# OCR_VLM_MAX_OUTPUT_TOKENS=2048
# API-side image upload gate (Spring): enable together with
# INGESTION_OCR_ENABLED so documents staff can test scanned uploads too.
# OCR_UPLOADS_ENABLED=false

# Optional Linux/Windows-WSL2 CPU reranker container. Apple Silicon uses the
# native TEI Metal runtime documented in docs/DEVELOPMENT.md.
RERANKER_ENABLED=false
RERANKER_URL=http://reranker-service
RERANKER_PORT=8082
RERANKER_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
RERANKER_MODEL_ID=Alibaba-NLP/gte-multilingual-reranker-base

SEAWEEDFS_BUCKET=openvie
SEAWEEDFS_MASTER_PORT=19334
SEAWEEDFS_MASTER_GRPC_PORT=29333
SEAWEEDFS_VOLUME_PORT=18123
SEAWEEDFS_FILER_PORT=18888
SEAWEEDFS_S3_PORT=18333
SEAWEEDFS_CONNECT_TIMEOUT_SECONDS=3
SEAWEEDFS_READ_TIMEOUT_SECONDS=30
SEAWEEDFS_MAX_ATTEMPTS=3

# Readiness and optional caches. Every cache defaults to off so a fresh
# install runs without unverified optimizations.
READINESS_DIAGNOSTICS_TIMEOUT_SECONDS=0.5
READINESS_INGESTION_SCAN_LIMIT=200
CACHE_ENABLED=false
CACHE_KEY_PREFIX=ccn:v1
CACHE_TTL_JITTER_PERCENT=10
EMBEDDING_CACHE_ENABLED=false
EMBEDDING_CACHE_TTL_SECONDS=86400
RETRIEVAL_CACHE_ENABLED=false
RETRIEVAL_CACHE_TTL_SECONDS=120
GENERATION_RESULT_CACHE_TTL_SECONDS=600
SEMANTIC_ANSWER_CACHE_MODE=off
SEMANTIC_ANSWER_CACHE_TTL_SECONDS=3600
SEMANTIC_ANSWER_CACHE_SIMILARITY_THRESHOLD=0.97
SEMANTIC_ANSWER_CACHE_COLLECTION=semantic_answer_cache_v1
SEMANTIC_ANSWER_CACHE_VECTOR_NAME=query_v1
SEMANTIC_ANSWER_CACHE_CANDIDATE_LIMIT=5
SEMANTIC_ANSWER_CACHE_CLEANUP_BATCH_SIZE=1000

# Integration surfaces (API keys + webhooks). CONSUMER_RATE_LIMIT_PER_MINUTE
# meters authenticated traffic per tenant+user in Redis; WEBHOOKS_ENABLED=false
# stops outbound delivery while the outbox keeps journaling (no data loss).
CONSUMER_RATE_LIMIT_PER_MINUTE=600
WEBHOOKS_ENABLED=true
WEBHOOKS_DISPATCH_INTERVAL_MS=5000

# ── Optional monitoring stack (profile: monitoring) ──────────────────────────
# Prometheus + Alertmanager + Grafana. Disabled by default; enable with:
#   docker compose --profile monitoring up -d
# All three publish on 127.0.0.1 only. Prometheus scrapes the host-run Spring
# API (:8080) and FastAPI AI service (:18000) via host.docker.internal.
# See docs/DEPLOYMENT.md#11-monitoring-prometheus--alertmanager--grafana.
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
