# Repository-root Compose configuration (local development).
#
# `docker compose` reads this file (copied to `.env`) for variable
# interpolation in docker-compose.yml. Host-run processes do not depend on it:
# Spring loads api/.env, the Next.js client loads frontend/.env.local, and the
# Python app reads rag-chatbot-fastapi/.env *on top of* this file, so
# service-level values win for any key defined in both places. That is why
# container DNS names (ollama, qdrant, reranker-service, ...) are safe here:
# keep host-reachable URLs in the service-level files.
#
# Copy with: test -f .env || cp .env.example .env

APP_ENV=development
LOG_LEVEL=INFO

# ── Interpolated into docker-compose.yml services ────────────────────────────
POSTGRES_DB=cacanode
POSTGRES_USER=cacanode
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=15432

REDIS_PORT=16379
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_OPERATION_TIMEOUT_SECONDS=1
RABBITMQ_DEFAULT_USER=rag_user
RABBITMQ_DEFAULT_PASS=rag_password
RABBITMQ_PORT=15673
RABBITMQ_MANAGEMENT_PORT=25672

QDRANT_HTTP_PORT=16333
QDRANT_GRPC_PORT=16334
QDRANT_COLLECTION=knowledge_units_v2
QDRANT_DENSE_VECTOR_NAME=text_bge_m3_v1
QDRANT_SPARSE_VECTOR_NAME=text_bm25_v1

GRAPH_SERVICE_PORT=8010
GRAPH_INTERNAL_TOKEN=development-graph-token
GRAPH_MAX_HOPS=3
GRAPH_EXTRACTION_BATCH_SIZE=4
GRAPH_EXTRACTION_MAX_OUTPUT_TOKENS=512
GRAPH_EXTRACTION_MAX_ENTITIES_PER_UNIT=2
GRAPH_EXTRACTION_MAX_RELATIONS_PER_UNIT=2

# Edge gateway (Apache APISIX). Single HTTP entry point for the web client and
# the business API; see docs/DEPLOYMENT.md#9-edge-gateway-apache-apisix.
# Port 8088 is the one Caddyfile.dev also uses: run one of them, not both.
APISIX_PORT=8088

# Concurrent in-flight documents per worker. Raises ingestion throughput but
# requires the model server to serve parallel requests.
INGESTION_WORKER_CONCURRENCY=4

# Optional Linux/Windows-WSL2 CPU reranker container. Apple Silicon uses the
# native TEI Metal runtime documented in docs/DEVELOPMENT.md.
RERANKER_ENABLED=false
RERANKER_URL=http://reranker-service
RERANKER_PORT=8082
RERANKER_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
RERANKER_MODEL_ID=Alibaba-NLP/gte-multilingual-reranker-base

SEAWEEDFS_BUCKET=cacanode
SEAWEEDFS_MASTER_PORT=19334
SEAWEEDFS_MASTER_GRPC_PORT=29333
SEAWEEDFS_VOLUME_PORT=18123
SEAWEEDFS_FILER_PORT=18888
SEAWEEDFS_S3_PORT=18333
SEAWEEDFS_CONNECT_TIMEOUT_SECONDS=3
SEAWEEDFS_READ_TIMEOUT_SECONDS=30
SEAWEEDFS_MAX_ATTEMPTS=3

# Readiness and optional caches. Every cache defaults to off so a fresh
# install runs without unverified optimizations.
READINESS_DIAGNOSTICS_TIMEOUT_SECONDS=0.5
READINESS_INGESTION_SCAN_LIMIT=200
CACHE_ENABLED=false
CACHE_KEY_PREFIX=ccn:v1
CACHE_TTL_JITTER_PERCENT=10
EMBEDDING_CACHE_ENABLED=false
EMBEDDING_CACHE_TTL_SECONDS=86400
RETRIEVAL_CACHE_ENABLED=false
RETRIEVAL_CACHE_TTL_SECONDS=120
GENERATION_RESULT_CACHE_TTL_SECONDS=600
SEMANTIC_ANSWER_CACHE_MODE=off
SEMANTIC_ANSWER_CACHE_TTL_SECONDS=3600
SEMANTIC_ANSWER_CACHE_SIMILARITY_THRESHOLD=0.97
SEMANTIC_ANSWER_CACHE_COLLECTION=semantic_answer_cache_v1
SEMANTIC_ANSWER_CACHE_VECTOR_NAME=query_v1
SEMANTIC_ANSWER_CACHE_CANDIDATE_LIMIT=5
SEMANTIC_ANSWER_CACHE_CLEANUP_BATCH_SIZE=1000
