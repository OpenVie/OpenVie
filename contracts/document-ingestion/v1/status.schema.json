{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cacanode.local/contracts/document-ingestion/v1/status.schema.json",
  "title": "Document ingestion status v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "job_id", "tenant_id", "document_id",
    "status", "chunk_count", "error_message"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "format": "uuid"},
    "job_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "document_id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["PROCESSING", "COMPLETED", "FAILED"]},
    "chunk_count": {"type": ["integer", "null"], "minimum": 0},
    "error_message": {"type": ["string", "null"], "maxLength": 2000}
  }
}
