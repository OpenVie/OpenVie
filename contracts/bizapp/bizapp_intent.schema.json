{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvie.local/contracts/bizapp/bizapp_intent.schema.json",
  "title": "BizApp Intent Classification",
  "type": "object",
  "required": ["intent", "confidence"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["NONE", "LIST_APPS", "APP_DETAIL", "APP_DATA", "INSTALL", "UNINSTALL", "SUGGEST", "CREATE_APP"]
    },
    "appKind": {
      "type": ["string", "null"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "reply": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  }
}
