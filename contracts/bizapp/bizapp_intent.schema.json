{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvie.local/contracts/bizapp/bizapp_intent.schema.json",
  "title": "BizApp Intent Classification",
  "type": "object",
  "required": ["intent", "confidence"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["NONE", "LIST_APPS", "APP_DETAIL", "APP_DATA", "INSTALL", "UNINSTALL", "SUGGEST", "CREATE_APP",
        "APP_RECORD_CREATE", "APP_RECORD_UPDATE", "APP_RECORD_ARCHIVE", "APP_RECORD_SUBMIT"]
    },
    "appKind": {
      "type": ["string", "null"]
    },
    "entity": {
      "type": ["string", "null"]
    },
    "fields": {
      "type": "object",
      "description": "Optional raw slot values extracted by the model; the deterministic slot agent re-normalizes them against the installed app manifest."
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "reply": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  }
}
