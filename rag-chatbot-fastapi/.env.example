# Runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=18000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
DEFAULT_LOCALE=vi-VN
READINESS_REQUIRE_MODELS=false

# Internal gRPC, cache, and queue
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_PLAINTEXT=true
GENERATION_RESULT_CACHE_TTL_SECONDS=600
REDIS_URL=redis://localhost:16379/0
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_OPERATION_TIMEOUT_SECONDS=1
CACHE_ENABLED=false
CACHE_KEY_PREFIX=ccn:v1
CACHE_TTL_JITTER_PERCENT=10
EMBEDDING_CACHE_ENABLED=false
EMBEDDING_CACHE_TTL_SECONDS=86400
RETRIEVAL_CACHE_ENABLED=false
RETRIEVAL_CACHE_TTL_SECONDS=120
SEMANTIC_ANSWER_CACHE_MODE=off
SEMANTIC_ANSWER_CACHE_TTL_SECONDS=3600
SEMANTIC_ANSWER_CACHE_SIMILARITY_THRESHOLD=0.97
SEMANTIC_ANSWER_CACHE_COLLECTION=semantic_answer_cache_v1
SEMANTIC_ANSWER_CACHE_VECTOR_NAME=query_v1
SEMANTIC_ANSWER_CACHE_CANDIDATE_LIMIT=5
SEMANTIC_ANSWER_CACHE_CLEANUP_BATCH_SIZE=1000
RABBITMQ_URL=amqp://rag_user:rag_password@localhost:15673/

# Object storage
SEAWEEDFS_MASTER_URL=http://localhost:19334
SEAWEEDFS_FILER_URL=http://localhost:18888
SEAWEEDFS_S3_ENDPOINT=http://localhost:18333
SEAWEEDFS_ACCESS_KEY=
SEAWEEDFS_SECRET_KEY=
SEAWEEDFS_BUCKET=cacanode
SEAWEEDFS_CONNECT_TIMEOUT_SECONDS=3
SEAWEEDFS_READ_TIMEOUT_SECONDS=30
SEAWEEDFS_MAX_ATTEMPTS=3

# Vector and graph storage
QDRANT_URL=http://localhost:16333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_units_v2
QDRANT_DENSE_VECTOR_NAME=text_bge_m3_v1
QDRANT_SPARSE_VECTOR_NAME=text_bm25_v1
QDRANT_TENANT_FIELD=tenant_id
QDRANT_KNOWLEDGE_BASE_FIELD=knowledge_base_id
KUZU_DATABASE_PATH=./data/kuzu/cacanode.kuzu
GRAPH_SERVICE_URL=http://localhost:8010

# Internal model serving
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_INTERNAL_API_KEY=ollama
LLM_MODEL_ID=vylinh
LLM_ADAPTER_ID=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=512
GRAPH_EXTRACTION_MAX_OUTPUT_TOKENS=512
GRAPH_EXTRACTION_MAX_ENTITIES_PER_UNIT=2
GRAPH_EXTRACTION_MAX_RELATIONS_PER_UNIT=2
GRAPH_EXTRACTION_REASONING_EFFORT=low
GRAPH_EXTRACTION_BATCH_SIZE=4
LLM_TIMEOUT_SECONDS=90
LLM_USE_OLLAMA_NATIVE_CHAT=true
LLM_DISABLE_THINKING=true

# Local macOS alternative: externally managed MLX/Qwen generation
# LLM_PROVIDER=qwen
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_MODEL_ID=mlx-community/Qwen2.5-14B-Instruct-4bit

# Text embeddings
TEXT_EMBEDDING_BASE_URL=http://localhost:11434
TEXT_EMBEDDING_MODEL_ID=bge-m3
TEXT_EMBEDDING_DIMENSION=1024
TEXT_EMBEDDING_TIMEOUT_SECONDS=120
TEXT_EMBEDDING_BATCH_SIZE=32
SPARSE_MODEL_ID=Qdrant/bm25
SPARSE_MODEL_CACHE_DIR=./data/models/fastembed

# Optional TEI cross-encoder reranker. Start the platform-appropriate runtime
# before enabling it; failure falls back to the fused retrieval order.
RERANKER_ENABLED=false
RERANKER_URL=http://localhost:8082
RERANKER_MODEL_ID=Alibaba-NLP/gte-multilingual-reranker-base
RERANKER_TIMEOUT_SECONDS=20

# Optional: OpenTelemetry OTLP export. Empty disables exporting.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Worker lifecycle. `dev` starts an embedded document worker; use
# WORKER_MODE=disabled with a separate consumer process instead.
# WORKER_KINDS=document
# WORKER_POLL_INTERVAL_SECONDS=2.0
# Concurrent in-flight documents; requires parallel model serving.
# INGESTION_WORKER_CONCURRENCY=4

