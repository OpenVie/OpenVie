{
  "envelope": "openvie.template.v1",
  "meta": {
    "author": "LinkedNodeDigital",
    "license": "Apache-2.0",
    "source": "bundled",
    "sha256": "cf6296680914a541a431d35d18b4424821d51fc4bc838e81dc91f55ce2341ac7",
    "generator": "human",
    "model": null,
    "changes": []
  },
  "manifest": {
    "schema": "bizapp.v1",
    "kind": "crm",
    "name": {
      "vi": "CRM-lite",
      "en": "CRM Lite"
    },
    "version": 1,
    "icon": "briefcase",
    "storage": "jsonb",
    "rbac": {
      "read": [
        "ORG_OWNER",
        "WORKSPACE_ADMIN",
        "MEMBER"
      ],
      "write": [
        "WORKSPACE_ADMIN",
        "MEMBER"
      ]
    },
    "conversational": {
      "triggers": [
        "khách hàng",
        "khách",
        "lead",
        "leads",
        "hợp đồng",
        "thương vụ",
        "crm"
      ],
      "description": "Quản lý thông tin khách hàng tiềm năng và quy trình bán hàng"
    },
    "entities": [
      {
        "name": "leads",
        "label": {
          "vi": "Khách hàng tiềm năng",
          "en": "Leads"
        },
        "fields": [
          {
            "name": "name",
            "type": "string",
            "required": true,
            "maxLen": 200,
            "label": {
              "vi": "Tên khách hàng",
              "en": "Customer name"
            }
          },
          {
            "name": "email",
            "type": "string",
            "format": "email",
            "maxLen": 200
          },
          {
            "name": "phone",
            "type": "string",
            "maxLen": 40
          },
          {
            "name": "stage",
            "type": "enum",
            "required": true,
            "options": [
              "NEW",
              "CONTACTED",
              "QUALIFIED",
              "WON",
              "LOST"
            ]
          },
          {
            "name": "dealValue",
            "type": "number",
            "required": false
          },
          {
            "name": "notes",
            "type": "string",
            "maxLen": 500
          }
        ],
        "knowledge": {
          "project": true,
          "titleField": "name",
          "fields": [
            "name",
            "email",
            "phone",
            "stage",
            "dealValue",
            "notes"
          ]
        },
        "hooks": {
          "onCreate": [
            "notifyOwner"
          ]
        }
      }
    ],
    "blocks": [
      {
        "id": "notifyOwner",
        "type": "notify",
        "params": {
          "to": [
            "creator"
          ],
          "title": "Lead mới đã được ghi nhận",
          "subject": "OpenVie CRM — lead mới"
        }
      },
      {
        "id": "leadPipeline",
        "type": "report",
        "params": {
          "views": [
            {
              "name": "pipeline",
              "entity": "leads",
              "orderBy": [
                {
                  "by": "name",
                  "dir": "asc"
                }
              ],
              "limit": 100,
              "engine": "postgres"
            },
            {
              "name": "pipeline_by_stage",
              "entity": "leads",
              "groupBy": [
                "stage"
              ],
              "metrics": [
                {
                  "fn": "count",
                  "as": "leads"
                },
                {
                  "fn": "sum",
                  "field": "dealValue",
                  "as": "value"
                }
              ],
              "orderBy": [
                {
                  "by": "leads",
                  "dir": "desc"
                }
              ],
              "limit": 100,
              "engine": "postgres"
            }
          ]
        }
      }
    ],
    "ui": {
      "views": [
        "registry:leads",
        "form:leads",
        "report:pipeline"
      ]
    }
  }
}
