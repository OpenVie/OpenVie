# Spring API environment (local development).
# Copy with: test -f api/.env || cp api/.env.example api/.env
# `make -C api` targets source this file; values map onto the `dev` profile in
# api/src/main/resources/application-dev.yaml. Host URLs only: the containers
# started by docker-compose.yml publish these ports on localhost.

# Runtime
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Comma-separated origins. For an ngrok tunnel, append its exact https:// hostname.
ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
COOKIE_SECURE=false
# Trusted reverse proxies: only these peers may set X-Forwarded-For. When
# traffic reaches Spring through the APISIX gateway in docker-compose.yml, add
# the Docker bridge (for example 172.16.0.0/12) or audit records and the public
# rate limiter will key on the gateway address instead of the real client.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
PUBLIC_RATE_LIMIT_ENABLED=true
PUBLIC_RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_FILE_SIZE=20MB
MAX_UPLOAD_REQUEST_SIZE=21MB

# Authentication and authorization
TOKEN_KEY=change-me-access-token-signing-key-at-least-32-bytes
EXPIRY_MINS=15
EXPIRY_DAYS=30

# PostgreSQL (published by the root development Compose stack)
POSTGRES_URL=jdbc:postgresql://localhost:15432/cacanode
POSTGRES_PORT=15432
POSTGRES_DB=cacanode
POSTGRES_USER=cacanode
POSTGRES_PASSWORD=change-me

# Redis and RabbitMQ (host endpoints of the root development Compose stack)
REDIS_URL=redis://localhost:16379/0
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_OPERATION_TIMEOUT_SECONDS=1
RABBITMQ_URL=amqp://rag_user:rag_password@localhost:15673/

# Optional caches. All default to off; enable individually and observe behavior.
CACHE_ENABLED=false
CACHE_KEY_PREFIX=ccn:v2
CACHE_TTL_JITTER_PERCENT=10
BUSINESS_READ_CACHE_ENABLED=false
WORKSPACE_CACHE_ENABLED=false
WORKSPACE_CACHE_TTL_SECONDS=300
USER_DIRECTORY_CACHE_ENABLED=false
USER_DIRECTORY_CACHE_TTL_SECONDS=30
DOCUMENT_LIST_CACHE_ENABLED=false
DOCUMENT_LIST_CACHE_TTL_SECONDS=15
EMBEDDING_CACHE_ENABLED=false
RETRIEVAL_CACHE_ENABLED=false

# S3-compatible object storage exposed by the root development Compose stack
SEAWEEDFS_S3_ENDPOINT=http://localhost:18333
SEAWEEDFS_BUCKET=cacanode
SEAWEEDFS_ACCESS_KEY=
SEAWEEDFS_SECRET_KEY=
SEAWEEDFS_REGION=us-east-1

# AI API integration (gRPC to the host Python app, `make -C rag-chatbot-fastapi dev`)
AI_GRPC_TARGET=localhost:50051
AI_GRPC_PLAINTEXT=true
AI_ANSWER_DEADLINE_SECONDS=100
AI_DOCUMENT_UNITS_DEADLINE_SECONDS=10
AI_DELETION_DEADLINE_SECONDS=15

# Email. The dev profile defaults to a local mail catcher (Mailpit/MailHog) on
# MAIL_HOST:MAIL_PORT, so invitation messages are readable locally without an
# external provider credential. Set MAIL_PROVIDER=none to run without email:
# invitations are then refused at creation, everything else keeps working.
# NOTIFICATION_ENC_KEY enables per-organization channels stored in settings
# (generate with: openssl rand -base64 32).
MAIL_PROVIDER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_HEALTH_ENABLED=false
NOTIFICATION_ENC_KEY=
SENDGRID_API_KEY=
BREVO_API_KEY=
FROM_EMAIL=no-reply@cacanode.local
FROM_NAME=OpenVie
INVITATION_LINK=http://localhost:3000/accept-invitation
